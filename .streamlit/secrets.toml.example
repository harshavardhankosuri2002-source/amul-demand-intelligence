# Example secrets configuration for AMUL AI Demand & Distribution Intelligence System
# Copy this file to .streamlit/secrets.toml and fill in your authorized API credentials.
# NEVER commit the actual secrets.toml file to version control.

[api]
# Target URL for authorized distributor / ERP demand data service
base_url = "https://api.example.com/v1/amul-distribution"

# Authorization token (e.g. Bearer token, API Key)
api_key = "YOUR_SECURE_API_KEY_HERE"

# Request timeout in seconds
timeout_seconds = 10

# Max records per page for pagination
page_size = 500

[database]
# Optional direct SQL connection string if connecting to an authorized reporting replica
# connection_string = "postgresql://user:password@localhost:5432/amul_distribution_db"
